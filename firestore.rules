rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Product catalog: allow public read and stock updates
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders: allow customer creation and order history reading
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // System audit & replication logs
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
